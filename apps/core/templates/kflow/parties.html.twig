{% extends 'base.html.twig' %}

{% block title %}KFlow360 · {{ title }}{% endblock %}
{% block page_title %}{{ title }}{% endblock %}

{% block main %}
    <section class="kflow-page-heading">
        <div><span class="kflow-eyebrow">Kadastro360</span><h1>{{ title }}</h1><p>{% if activeErp %}Consulta orientada conforme o ERP selecionado: {{ activeErp }}.{% else %}Selecione um ERP para iniciar a consulta de {{ title|lower }}.{% endif %}</p></div>
        <div class="kflow-page-actions"><button class="btn btn-outline-primary" type="button" data-layout-customize="{{ partyType }}"><i class="bi bi-sliders"></i>Personalizar</button><button class="btn btn-outline-secondary" type="button" data-layout-cancel="{{ partyType }}" hidden><i class="bi bi-x-lg"></i>Cancelar</button><a class="btn btn-outline-primary" href="{{ activeErp ? path('kflow_erp_connect', {erp: activeErp}) : path('kflow_erp_index') }}"><i class="bi bi-hdd-network"></i>{{ activeErp ?: 'Selecionar ERP' }}</a></div>
    </section>

    {% if activeErp == 'Senior' and partyData.parties is not empty %}
        {% set firstParty = partyData.parties|first %}
        <section class="kflow-product-workspace kflow-layout-grid" data-layout-grid="{{ partyType }}-main">
            <div class="kflow-surface kflow-product-list kflow-layout-card" data-layout-card="list" draggable="false">
                <button class="kflow-layout-card__hide" type="button" data-layout-hide title="Ocultar lista" aria-label="Ocultar lista de {{ title|lower }}"><i class="bi bi-eye-slash"></i></button>
                <div class="kflow-section-heading"><div><span class="kflow-eyebrow">{{ partyData.sourceTable }}</span><h2>{{ title }} encontrados</h2></div><span class="badge text-bg-light">{{ partyData.recordCount }} registros</span></div>
                <div class="kflow-table-caption">Exibindo {{ ((partyData.page - 1) * partyData.perPage) + 1 }} a {{ ((partyData.page - 1) * partyData.perPage) + partyData.parties|length }} de {{ partyData.recordCount }} registros.</div>
                <div class="table-responsive"><table class="table table-hover kflow-table"><thead><tr><th>Código</th><th>{{ singular }}</th><th>Documento</th><th>UF</th><th></th></tr></thead><tbody>{% for party in partyData.parties %}<tr class="{{ loop.first ? 'is-selected' }}" data-party-row><td><strong>{{ party.Code }}</strong></td><td>{{ party.Name }}</td><td>{{ party.Document ?: '-' }}</td><td>{{ party.State ?: '-' }}</td><td class="text-end"><button type="button" class="kflow-icon-button" data-party-select data-party="{{ party|json_encode|e('html_attr') }}" aria-label="Ver {{ singular|lower }} {{ party.Code }}" title="Ver detalhes"><i class="bi bi-arrow-right"></i></button></td></tr>{% endfor %}</tbody></table></div>
                {% if partyData.pageCount > 1 %}<nav class="kflow-pagination" aria-label="Paginação de {{ title|lower }}"><span>Página {{ partyData.page }} de {{ partyData.pageCount }}</span><div>{% if partyData.page > 1 %}<a class="btn btn-sm btn-outline-primary" href="{{ path(partyType == 'suppliers' ? 'kflow_suppliers' : 'kflow_carriers', {page: partyData.page - 1}) }}"><i class="bi bi-chevron-left"></i>Anterior</a>{% endif %}{% if partyData.page < partyData.pageCount %}<a class="btn btn-sm btn-outline-primary" href="{{ path(partyType == 'suppliers' ? 'kflow_suppliers' : 'kflow_carriers', {page: partyData.page + 1}) }}">Próxima<i class="bi bi-chevron-right"></i></a>{% endif %}</div></nav>{% endif %}
            </div>
            <aside class="kflow-surface kflow-product-detail kflow-layout-card" data-layout-card="detail" draggable="false">
                <button class="kflow-layout-card__hide" type="button" data-layout-hide title="Ocultar informações" aria-label="Ocultar informações"><i class="bi bi-eye-slash"></i></button>
                <span class="kflow-eyebrow">{{ singular }} selecionado</span><h2>Informações cadastrais</h2>
                <div class="kflow-customer-detail">{% for key, label in {'Code': 'Código do ERP', 'Name': 'Nome / Razão social', 'Document': 'CPF / CNPJ', 'Phone': 'Telefone', 'Email': 'E-mail', 'Address': 'Endereço', 'City': 'Cidade', 'State': 'UF', 'UpdatedAt': 'Última atualização'} %}<div><small>{{ label }}</small><strong data-party-field="{{ key }}">{{ firstParty[key]|default('Não informado') }}</strong></div>{% endfor %}</div>
            </aside>
        </section>

        <section class="kflow-product-insights kflow-layout-grid" data-layout-grid="{{ partyType }}-insights">
            <div class="kflow-surface kflow-sanitization kflow-layout-card" data-layout-card="sanitization" draggable="false"><button class="kflow-layout-card__hide" type="button" data-layout-hide title="Ocultar sanitização" aria-label="Ocultar sanitização"><i class="bi bi-eye-slash"></i></button><div class="kflow-section-heading"><div><span class="kflow-eyebrow">Sanitização</span><h2>Qualidade de cadastro</h2></div><i class="bi bi-person-check"></i></div><strong>{{ partyData.missingAddressCount }} {{ singular|lower }}(s) sem endereço</strong><p>Use esta área para revisar endereços, contatos e possíveis duplicidades do cadastro.</p></div>
            <div class="kflow-surface kflow-fiscal-review kflow-layout-card" data-layout-card="fiscal" draggable="false"><button class="kflow-layout-card__hide" type="button" data-layout-hide title="Ocultar dados fiscais" aria-label="Ocultar dados fiscais"><i class="bi bi-eye-slash"></i></button><div class="kflow-section-heading"><div><span class="kflow-eyebrow">Dados fiscais</span><h2>Revisão cadastral</h2></div><i class="bi bi-file-earmark-text"></i></div><p>Dados fiscais e validações documentais serão apresentados aqui conforme os campos vinculados na conexão do ERP.</p><span class="kflow-fiscal-review__ncm">{{ partyData.staleCount }} cadastro(s) para atualização</span></div>
        </section>
    {% elseif activeErp == 'Senior' %}
        <section class="kflow-development-state"><span class="kflow-development-state__icon"><i class="bi bi-{{ icon }}"></i></span><div><span class="kflow-eyebrow">Senior · {{ partyData.sourceTable }}</span><h2>{{ partyData.error ?: (partyData.configured ? 'Nenhum registro encontrado' : 'Conexão Senior pendente') }}</h2><p>{% if partyData.configured %}Confira a tabela vinculada para {{ title|lower }} em Conectar ERP.{% else %}Abra Conectar ERP, selecione o ERP e a tabela, e faça o vínculo de campos para visualizar os dados.{% endif %}</p>{% if not partyData.configured %}<a class="btn btn-primary btn-sm mt-3" href="{{ path('kflow_erp_connect', {erp: 'Senior', method: 'database', step: 'table', form: partyType}) }}"><i class="bi bi-hdd-network"></i>Conectar ERP e vincular tabela</a>{% endif %}</div></section>
    {% else %}
        <section class="kflow-development-state"><span class="kflow-development-state__icon"><i class="bi bi-{{ icon }}"></i></span><div><span class="kflow-eyebrow">{{ title }}{% if activeErp %} · {{ activeErp }}{% else %} · ERP não selecionado{% endif %}</span><h2>{{ activeErp ? 'Em desenvolvimento' : 'Selecione o ERP e a tabela' }}</h2><p>{% if activeErp %}A consulta de {{ title|lower }} para {{ activeErp }} será acrescentada em uma próxima etapa.{% else %}Abra Conectar ERP, selecione o ERP, informe o modo de conexão e faça o vínculo da tabela para visualizar os dados.{% endif %}</p>{% if not activeErp %}<a class="btn btn-primary btn-sm mt-3" href="{{ path('kflow_erp_index') }}"><i class="bi bi-hdd-network"></i>Selecionar ERP</a>{% endif %}</div></section>
    {% endif %}
{% endblock %}
