{% extends 'base.html.twig' %}
{% block title %}KFlow360 · Empresas{% endblock %}
{% block page_title %}Empresas{% endblock %}
{% block main %}
<section class="kflow-page-heading kflow-page-heading--compact"><div><span class="kflow-eyebrow">Configurações de Conexão</span><h1>Empresas</h1><p>Crie a empresa que concentrará seus ERPs, cadastros e usuários.</p></div></section>
<div class="kflow-company-layout"><section class="kflow-surface"><h2>Nova empresa</h2><form action="{{ path('kflow_companies_create') }}" method="post" class="kflow-form-grid"><input type="hidden" name="_token" value="{{ csrf_token('create-company') }}"><div><label class="form-label">Nome</label><input class="form-control" name="name" required></div><div><label class="form-label">Razão social</label><input class="form-control" name="legal_name"></div><div><label class="form-label">CNPJ</label><input class="form-control" name="document"></div><div class="kflow-company-layout__action"><button class="btn btn-primary" type="submit"><i class="bi bi-building-add"></i>Criar empresa</button></div></form></section><section class="kflow-surface"><h2>Empresas disponíveis</h2><div class="kflow-company-list">{% for company in companies %}<form action="{{ path('kflow_company_select', {company: company.id}) }}" method="post" class="{{ activeCompany and activeCompany.id == company.id ? 'is-active' }}"><input type="hidden" name="_token" value="{{ csrf_token('select-company-'~company.id) }}"><input type="hidden" name="redirect" value="{{ path('kflow_erp_index') }}"><span><strong>{{ company.name }}</strong><small>{{ company.legalName ?: 'Sem razão social informada' }}</small></span><button class="btn btn-outline-primary" type="submit">{{ activeCompany and activeCompany.id == company.id ? 'Selecionada' : 'Selecionar' }}</button></form>{% else %}<p class="kflow-inline-note">Nenhuma empresa cadastrada.</p>{% endfor %}</div></section></div>
{% endblock %}
