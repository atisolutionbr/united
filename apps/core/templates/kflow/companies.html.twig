{% extends 'base.html.twig' %}
{% block title %}United Ati · Empresas{% endblock %}{% block page_title %}Empresas{% endblock %}
{% block main %}
<section class="kflow-page-heading kflow-page-heading--compact"><div><span class="kflow-eyebrow">Configurações United Ati</span><h1>Empresas e holdings</h1><p>O KAdmin cria as empresas e associa os CNPJs ao grupo que as administra.</p></div></section>
<div class="kflow-company-layout"><section class="kflow-surface"><h2>Nova empresa</h2><form action="{{ path('kflow_companies_create') }}" method="post" class="kflow-form-grid" data-company-form data-cnpj-url="{{ path('kflow_company_cnpj', {document: 'CNPJ'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('create-company') }}"><div><label class="form-label" for="company-cnpj">CNPJ</label><input class="form-control" id="company-cnpj" name="document" inputmode="numeric" maxlength="18" data-company-cnpj required><small class="kflow-input-help" data-cnpj-status>Digite o CNPJ para buscar os dados públicos.</small></div><div><label class="form-label" for="company-holding">Holding / grupo</label><input class="form-control" id="company-holding" name="holding_name" placeholder="Ex.: Grupo KFlow"></div><div class="kflow-form-grid__wide"><label class="form-label" for="company-name">Nome fantasia</label><input class="form-control" id="company-name" name="name" data-company-name required></div><div class="kflow-form-grid__wide"><label class="form-label" for="company-legal">Razão social</label><input class="form-control" id="company-legal" name="legal_name" data-company-legal></div><div class="kflow-company-layout__action"><button class="btn btn-primary" type="submit"><i class="bi bi-building-add"></i>Criar empresa</button></div></form></section><section class="kflow-surface"><h2>Empresas disponíveis</h2><div class="kflow-company-list">{% for company in companies %}<form action="{{ path('kflow_company_select', {company: company.id}) }}" method="post" class="{{ activeCompany and activeCompany.id == company.id ? 'is-active' }}"><input type="hidden" name="_token" value="{{ csrf_token('select-company-'~company.id) }}"><input type="hidden" name="redirect" value="{{ path('kflow_erp_index') }}"><span><strong>{{ company.name }}</strong><small>{{ company.holdingName ? company.holdingName~' · ' : '' }}{{ company.document ?: 'Sem CNPJ informado' }}</small></span><button class="btn btn-outline-primary" type="submit">{{ activeCompany and activeCompany.id == company.id ? 'Selecionada' : 'Selecionar' }}</button></form>{% else %}<p class="kflow-inline-note">Nenhuma empresa cadastrada.</p>{% endfor %}</div></section></div>
{% endblock %}
