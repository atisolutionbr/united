{% extends 'base.html.twig' %}

{% block title %}KFlow360 · Clientes{% endblock %}
{% block page_title %}Clientes{% endblock %}

{% block main %}
    <section class="kflow-page-heading">
        <div><span class="kflow-eyebrow">Kadastro360</span><h1>Clientes</h1><p>{% if activeErp %}Consulta orientada pelo ERP {{ activeErp }}.{% else %}Selecione um ERP para iniciar a consulta de clientes.{% endif %}</p></div>
        <div class="kflow-page-actions"><button class="btn btn-outline-primary" type="button" data-layout-customize="clients"><i class="bi bi-sliders"></i>Personalizar</button><button class="btn btn-outline-secondary" type="button" data-layout-cancel="clients" hidden><i class="bi bi-x-lg"></i>Cancelar</button><a class="btn btn-outline-primary" href="{{ activeErp ? path('kflow_erp_connect', {erp: activeErp}) : path('kflow_erp_index') }}"><i class="bi bi-hdd-network"></i>{{ activeErp ?: 'Selecionar ERP' }}</a></div>
    </section>

    {% if activeErp == 'Senior' and customerData.customers is not empty %}
        {% set firstCustomer = customerData.customers|first %}
        <section class="kflow-product-workspace kflow-layout-grid" data-layout-grid="clients-main">
            <div class="kflow-surface kflow-product-list kflow-layout-card" data-layout-card="list" draggable="false">
                <button class="kflow-layout-card__hide" type="button" data-layout-hide title="Ocultar lista" aria-label="Ocultar lista de clientes"><i class="bi bi-eye-slash"></i></button>
                <div class="kflow-section-heading"><div><span class="kflow-eyebrow">{{ customerData.sourceTable }}</span><h2>Clientes encontrados</h2></div><span class="badge text-bg-light">{{ customerData.recordCount }} registros</span></div>
                <div class="kflow-table-caption">Exibindo {{ ((customerData.page - 1) * customerData.perPage) + 1 }} a {{ ((customerData.page - 1) * customerData.perPage) + customerData.customers|length }} de {{ customerData.recordCount }} registros.</div>
                <div class="table-responsive"><table class="table table-hover kflow-table"><thead><tr><th>Empresa</th><th>Código</th><th>Cliente</th><th>UF</th><th></th></tr></thead><tbody>{% for customer in customerData.customers %}<tr class="{{ loop.first ? 'is-selected' }}" data-customer-row><td>{{ customer.CodEmp }}</td><td><strong>{{ customer.CodCli }}</strong></td><td>{{ customer.NomCli }}</td><td>{{ customer.SigUfs }}</td><td class="text-end"><button type="button" class="kflow-icon-button" data-customer-select data-customer="{{ customer|json_encode|e('html_attr') }}" aria-label="Ver cliente {{ customer.CodCli }}" title="Ver cliente"><i class="bi bi-arrow-right"></i></button></td></tr>{% endfor %}</tbody></table></div>
                {% if customerData.pageCount > 1 %}<nav class="kflow-pagination" aria-label="Paginação de clientes"><span>Página {{ customerData.page }} de {{ customerData.pageCount }}</span><div>{% if customerData.page > 1 %}<a class="btn btn-sm btn-outline-primary" href="{{ path('kflow_clients', {page: customerData.page - 1}) }}"><i class="bi bi-chevron-left"></i>Anterior</a>{% endif %}{% if customerData.page < customerData.pageCount %}<a class="btn btn-sm btn-outline-primary" href="{{ path('kflow_clients', {page: customerData.page + 1}) }}">Próxima<i class="bi bi-chevron-right"></i></a>{% endif %}</div></nav>{% endif %}
            </div>
            <aside class="kflow-surface kflow-product-detail kflow-layout-card" data-layout-card="detail" draggable="false">
                <button class="kflow-layout-card__hide" type="button" data-layout-hide title="Ocultar informações" aria-label="Ocultar informações do cliente"><i class="bi bi-eye-slash"></i></button>
                <span class="kflow-eyebrow">Cliente selecionado</span><h2>Informações do cliente</h2>
                <div class="kflow-customer-detail">
                    {% for key, label in {'CodEmp': 'Empresa', 'CodCli': 'Código do cliente', 'NomCli': 'Nome / Razão social', 'CgcCpf': 'CPF / CNPJ', 'EmlCli': 'E-mail', 'EndCli': 'Endereço', 'CidCli': 'Cidade', 'SigUfs': 'UF', 'DatAlt': 'Última atualização'} %}
                        <div><small>{{ label }}</small><strong data-customer-field="{{ key }}">{{ firstCustomer[key]|default('Não informado') }}</strong></div>
                    {% endfor %}
                </div>
            </aside>
        </section>

        <section class="kflow-product-insights kflow-layout-grid" data-layout-grid="clients-insights">
            <div id="sanitization" class="kflow-surface kflow-sanitization kflow-layout-card" data-layout-card="sanitization" draggable="false">
                <button class="kflow-layout-card__hide" type="button" data-layout-hide title="Ocultar sanitização" aria-label="Ocultar sanitização de clientes"><i class="bi bi-eye-slash"></i></button>
                <div class="kflow-section-heading"><div><span class="kflow-eyebrow">Sanitização</span><h2>Qualidade de cadastro</h2></div><i class="bi bi-person-check"></i></div>
                <strong>{{ customerData.missingAddressCount }} cliente(s) sem endereço</strong>
                <p>Use esta área para revisar endereços, contatos e possíveis duplicidades do cadastro de clientes.</p>
            </div>
            <div id="fiscal" class="kflow-surface kflow-fiscal-review kflow-layout-card" data-layout-card="fiscal" draggable="false">
                <button class="kflow-layout-card__hide" type="button" data-layout-hide title="Ocultar dados fiscais" aria-label="Ocultar dados fiscais de clientes"><i class="bi bi-eye-slash"></i></button>
                <div class="kflow-section-heading"><div><span class="kflow-eyebrow">Dados fiscais</span><h2>Revisão cadastral</h2></div><i class="bi bi-file-earmark-text"></i></div>
                <p>Dados fiscais e validações documentais serão apresentados aqui conforme os campos vinculados na conexão do ERP.</p>
                <span class="kflow-fiscal-review__ncm">{{ customerData.staleCount }} cadastro(s) para atualização</span>
            </div>
        </section>
    {% elseif activeErp == 'Senior' %}
        <section class="kflow-development-state"><span class="kflow-development-state__icon"><i class="bi bi-people"></i></span><div><span class="kflow-eyebrow">Senior · {{ customerData.sourceTable }}</span><h2>{{ customerData.error ?: (customerData.configured ? 'Nenhum cliente encontrado' : 'Conexão Senior pendente') }}</h2><p>{% if customerData.configured %}Confira a tabela vinculada para Clientes em Conectar ERP.{% else %}Abra Conectar ERP, selecione Banco de dados e vincule o formulário Clientes à tabela correta do Senior.{% endif %}</p></div></section>
    {% else %}
        <section class="kflow-development-state"><span class="kflow-development-state__icon"><i class="bi bi-people"></i></span><div><span class="kflow-eyebrow">Clientes{% if activeErp %} · {{ activeErp }}{% endif %}</span><h2>Em desenvolvimento</h2><p>{% if activeErp %}A consulta de clientes para {{ activeErp }} será acrescentada em uma próxima etapa.{% else %}Selecione um ERP em Configurações de Conexão para continuar.{% endif %}</p></div></section>
    {% endif %}
{% endblock %}
