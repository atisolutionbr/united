{% extends 'base.html.twig' %}
{% block title %}United Ati · Vínculos de {{ title }}{% endblock %}
{% block page_title %}Vínculos · {{ title }}{% endblock %}
{% block main %}
<section class="kflow-page-heading"><div><span class="kflow-eyebrow">{{ erp }}</span><h1>Vínculos de {{ title }}</h1><p>Cadastre uma origem para cada tabela ou serviço. Use a chave completa do objeto e os códigos de situação definidos pelo ERP.</p></div><a class="btn btn-outline-primary" href="{{ path('united_approvals') }}">Aprovações</a></section>
<section class="kflow-surface"><h2>Origens salvas</h2><div class="united-binding-list">{% for binding in bindings %}<a class="btn btn-outline-primary" href="{{ path('united_process_bindings', {process: process, id: binding.id}) }}">{{ binding.label }} · {{ binding.config.table|default(binding.config.method) }} · {{ binding.config.mapping|length }} campos · {{ binding.config.purpose == 'create' ? 'Envio' : 'Aprovação' }}</a>{% else %}<p>Nenhuma origem cadastrada.</p>{% endfor %}<a href="{{ path('united_process_bindings', {process: process}) }}">+ Nova origem</a></div></section>
{% if error %}<div class="alert alert-warning mt-3">{{ error }}</div>{% endif %}
<section class="kflow-surface mt-4"><h2>{{ id ? 'Editar origem' : 'Nova origem' }}</h2>
<form method="get" class="kflow-form-grid"><input type="hidden" name="id" value="{{ id }}"><label>Conexão<select class="form-select" name="method">{% for key, text in {'database': 'Banco de dados', 'api': 'API', 'webservice': 'WebService'} %}<option value="{{ key }}" {{ config.method == key ? 'selected' }}>{{ text }}</option>{% endfor %}</select></label><label>Finalidade<select class="form-select" name="purpose"><option value="approval" {{ config.purpose == 'approval' ? 'selected' }}>Consultar e aprovar objetos</option>{% if process in ['requests', 'requisitions'] %}<option value="create" {{ config.purpose == 'create' ? 'selected' }}>Enviar novo documento</option>{% endif %}</select></label>{% if config.method == 'database' %}<label>Tabela<select class="form-select" name="table"><option value="">Selecione</option>{% for table in tables %}<option {{ config.table|default('') == table ? 'selected' }}>{{ table }}</option>{% endfor %}</select></label>{% endif %}<button class="btn btn-outline-primary">Carregar campos desta origem</button></form>
<hr><form method="post" class="kflow-form-grid"><input type="hidden" name="_token" value="{{ csrf_token('process-binding-'~process) }}"><input type="hidden" name="config[method]" value="{{ config.method }}"><input type="hidden" name="config[purpose]" value="{{ config.purpose }}"><input type="hidden" name="config[table]" value="{{ config.table|default('') }}">
<label class="kflow-form-grid__wide">Nome da origem<input class="form-control" name="label" value="{{ label }}" maxlength="120" placeholder="Ex.: Solicitações de materiais — filial 1" required></label>
{% for key, field in fields %}<label>{{ field.label }}{% if config.method == 'database' %}<select class="form-select" name="config[mapping][{{ key }}]"><option value="">Sem vínculo</option>{% for column in columns %}<option {{ config.mapping[key]|default('') == column ? 'selected' }}>{{ column }}</option>{% endfor %}</select>{% else %}<input class="form-control" name="config[mapping][{{ key }}]" value="{{ config.mapping[key]|default('') }}" placeholder="objeto.{{ key }}">{% endif %}</label>{% endfor %}
{% if config.purpose == 'approval' %}
<label>Campos da chave completa (separados por vírgula)<input class="form-control" name="config[key_columns]" value="{{ config.key_columns|default('') }}" placeholder="empresa,filial,numero" required></label>
<label>Coluna / propriedade de situação<input class="form-control" name="config[status_column]" value="{{ config.status_column|default('') }}" required></label>
{% for key, text in {'pending_value': 'Código pendente', 'approved_value': 'Código aprovado', 'rejected_value': 'Código reprovado'} %}<label>{{ text }}<input class="form-control" name="config[{{ key }}]" value="{{ config[key]|default('') }}" required></label>{% endfor %}
{% endif %}
{% if config.method != 'database' %}
{% set options = config.purpose == 'approval' ? {'list_operation': 'Rota GET / operação de listagem', 'decision_operation': 'Rota POST / operação da decisão', 'items_path': 'Caminho da coleção de objetos', 'total_path': 'Caminho do total de pendências'} : {'create_operation': 'Rota POST / operação de inclusão'} %}
{% for key, text in options|merge({'success_path': 'Campo de confirmação no retorno', 'success_value': 'Valor que confirma sucesso'}) %}<label>{{ text }}<input class="form-control" name="config[{{ key }}]" value="{{ config[key]|default('') }}" required></label>{% endfor %}
{% if config.method == 'webservice' %}<label>Formato SOAP<select class="form-select" name="config[soap_style]"><option value="object">Objeto conforme WSDL</option><option value="named" {{ config.soap_style|default('') == 'named' ? 'selected' }}>Argumentos nomeados (RPC)</option></select></label><label>Propriedade de usuário na mensagem (opcional)<input class="form-control" name="config[soap_user_path]" value="{{ config.soap_user_path|default('') }}"></label><label>Propriedade de senha na mensagem (opcional)<input class="form-control" name="config[soap_password_path]" value="{{ config.soap_password_path|default('') }}"></label>{% endif %}
<p class="kflow-form-grid__wide">API utiliza o servidor e a credencial salvos em Conectar ERP, com rotas relativas. A listagem envia page, page_size=15 e status. O WebService utiliza o WSDL e a operação indicados. Configure a confirmação conforme o contrato do ERP.</p>
{% endif %}
<div class="kflow-form-grid__wide"><button class="btn btn-primary">Salvar vínculo</button> <a href="{{ path('kflow_erp_connect', {erp: erp, method: config.method}) }}">Configurar conexão e credenciais</a></div>
</form></section>
{% endblock %}
