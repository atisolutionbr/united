{% extends 'base.html.twig' %}
{% block title %}United Ati · Aprovações{% endblock %}
{% block page_title %}Aprovações{% endblock %}
{% block main %}
<section class="kflow-page-heading"><div><span class="kflow-eyebrow">{{ erp }}</span><h1>Aprovações</h1><p>Selecione o processo para conferir os objetos pendentes e devolver sua decisão ao ERP.</p></div></section>
<div class="kflow-erp-grid">{% for key, label in cards %}<article class="kflow-erp-card"><div class="kflow-erp-card__top"><span class="kflow-erp-card__mark"><i class="bi bi-check2-square fs-4 {{ loop.index is even ? 'text-primary' : '' }}" aria-hidden="true"></i></span></div><h2>{{ label }}</h2><p>{{ counts[key] }} origem(ns) de aprovação vinculada(s)</p><div class="mt-auto pt-3 position-relative"><a class="btn btn-primary w-100 mb-2" href="{{ path('united_approval_items', {process: key}) }}">Abrir pendências</a>{% if kflow_can('connections') %}<a class="btn btn-outline-primary w-100" href="{{ path('united_process_bindings', {process: key, purpose: 'approval'}) }}">Vincular tabelas / API / WS</a>{% endif %}</div></article>{% endfor %}</div>
{% endblock %}
