{% extends 'base.html.twig' %}
{% block title %}United Ati · {{ title }}{% endblock %}
{% block page_title %}{{ title }}{% endblock %}
{% block main %}
<section class="kflow-page-heading"><div><span class="kflow-eyebrow">{{ erp }}</span><h1>{{ title }}</h1><p>Preencha os dados, salve e confira o documento antes de enviá-lo ao ERP.</p></div>{% if kflow_can('connections') %}<a class="btn btn-outline-primary" href="{{ path('united_lookup_settings', {form: kind}) }}">Vínculos de listas</a><a class="btn btn-outline-primary" href="{{ path('united_process_bindings', {process: kind, purpose: 'create'}) }}">Vincular envio ao ERP</a>{% endif %}</section>
{% if error %}<div class="alert alert-warning">{{ error }}</div>{% endif %}
<section class="kflow-surface"><h2>Novo documento</h2><form method="post" class="kflow-form-grid">
<input type="hidden" name="_token" value="{{ csrf_token('document-'~kind) }}"><input type="hidden" name="request_key" value="{{ requestKey }}">
{% for key, field in fields %}{% if key in lookupFields %}
<div class="united-lookup" data-lookup data-url="{{ path('united_lookup', {form: kind, field: key}) }}"><label class="form-label" for="lookup-{{ key }}">{{ field.label }}{{ field.required|default(false) ? ' *' }}</label><input id="lookup-{{ key }}" class="form-control" data-lookup-search role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="lookup-results-{{ key }}" autocomplete="off" placeholder="Pesquisar código, nome{{ key == 'product' ? ' ou código de barras' }}" value="{{ input[key]|default('') }}" {{ field.required|default(false) ? 'required' }}><input type="hidden" data-lookup-value name="data[{{ key }}]" value="{{ input[key]|default('') }}"><input type="hidden" data-lookup-token name="lookup_tokens[{{ key }}]" value="{{ lookupTokens[key]|default('') }}"><small data-lookup-status aria-live="polite">Clique para listar ou digite para pesquisar.</small><div id="lookup-results-{{ key }}" class="united-lookup-results" role="listbox" data-lookup-results hidden></div></div>
{% else %}<label class="{{ field.type == 'textarea' ? 'kflow-form-grid__wide' }}">{{ field.label }}{{ field.required|default(false) ? ' *' }}
{% if field.type == 'textarea' %}<textarea class="form-control" name="data[{{ key }}]" maxlength="4000" rows="3" {{ field.required|default(false) ? 'required' }}>{{ input[key]|default('') }}</textarea>
{% elseif field.type == 'checkbox' %}<select class="form-select" name="data[{{ key }}]"><option value="0">Não</option><option value="1" {{ input[key]|default('0') == '1' ? 'selected' }}>Sim</option></select>
{% else %}<input class="form-control" type="{{ field.type }}" name="data[{{ key }}]" value="{{ input[key]|default('') }}" {{ field.type == 'number' ? 'min=0.000001 step=any' }} {{ field.required|default(false) ? 'required' }} maxlength="4000">{% endif %}</label>{% endif %}{% endfor %}
<div class="kflow-form-grid__wide"><button class="btn btn-primary">Salvar documento</button>{% if kflow_can('connections') %} <a href="{{ path('kflow_erp_connect', {erp: erp, method: 'database', form: kind, step: 'mapping'}) }}">Incluir campos adicionais</a>{% endif %}</div>
</form></section>
<section class="kflow-surface mt-4"><h2>Documentos salvos</h2><div class="table-responsive"><table class="table kflow-table"><thead><tr><th>Número</th><th>Produto</th><th>Quantidade</th><th>Solicitante</th><th>Envio</th><th></th></tr></thead><tbody>{% for doc in documents %}<tr><td>#{{ doc.id }}</td><td>{{ doc.payload._labels.product|default(doc.payload.product) }}</td><td>{{ doc.payload.quantity }}</td><td>{{ doc.payload._labels.requester|default(doc.payload.requester) }}</td><td>{{ {'draft': 'Rascunho', 'sending': 'Enviando / conferir ERP', 'sent': 'Confirmado pelo ERP', 'unconfirmed': 'Conferir retorno no ERP'}[doc.delivery_status]|default(doc.delivery_status) }}</td><td><a href="{{ path('united_document', {id: doc.id}) }}">Abrir / acompanhar</a></td></tr>{% else %}<tr><td colspan="6">Nenhum documento salvo.</td></tr>{% endfor %}</tbody></table></div><nav class="kflow-pagination"><span>Página {{ page }} · {{ total }} documentos</span><div>{% if page > 1 %}<a href="{{ path('united_documents', {kind: kind, page: page - 1}) }}">Anterior</a>{% endif %}{% if page * 15 < total %}<a href="{{ path('united_documents', {kind: kind, page: page + 1}) }}">Próxima</a>{% endif %}</div></nav></section>
{% endblock %}
