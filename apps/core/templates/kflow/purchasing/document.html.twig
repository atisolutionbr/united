{% extends 'base.html.twig' %}
{% block title %}United Ati · Documento #{{ doc.id }}{% endblock %}
{% block page_title %}Documento #{{ doc.id }}{% endblock %}
{% block main %}
<section class="kflow-page-heading"><div><h1>Documento #{{ doc.id }}</h1><p>{{ doc.payload.product }} · {{ doc.payload.requester }}</p></div><a class="btn btn-outline-primary" href="{{ path('united_documents', {kind: doc.kind}) }}">Voltar</a></section>
<section class="kflow-surface"><h2>Dados salvos</h2><dl class="kflow-form-grid">{% for key, value in doc.payload %}{% if key != '_labels' %}<div><dt>{{ fields[key].label|default(key) }}</dt><dd>{{ doc.payload._labels[key]|default(value) }}</dd></div>{% endif %}{% endfor %}</dl>
{% if doc.delivery_status == 'draft' %}<form method="post" class="kflow-form-grid"><input type="hidden" name="_token" value="{{ csrf_token('document-'~doc.id) }}"><input type="hidden" name="action" value="send"><label>Vínculo de envio<select class="form-select" name="binding" required><option value="">Selecione a origem</option>{% for binding in bindings %}<option value="{{ binding.id }}">{{ binding.label }} · {{ binding.config.table|default(binding.config.method) }}</option>{% endfor %}</select></label><button class="btn btn-primary" {{ bindings is empty ? 'disabled' }}>Enviar documento ao ERP</button></form>{% else %}<div class="alert {{ doc.delivery_status == 'sent' ? 'alert-success' : 'alert-warning' }}">{{ doc.delivery_status == 'sent' ? doc.receipt : 'Envio sem confirmação final. Confira o documento no ERP antes de qualquer novo envio.' }}</div>{% endif %}
{% if kflow_can('connections') %}<a href="{{ path('united_process_bindings', {process: doc.kind}) }}">Configurar vínculos</a>{% endif %}</section>
<section class="kflow-surface mt-4"><h2>Acompanhamento da compra</h2><p>Registre as conferências e referências de cada etapa. As decisões no ERP são enviadas pela central de Aprovações; geração de OC, NF e verificações financeiras devem ser confirmadas no ERP vinculado.</p><ol class="united-workflow">{% for key, label in stages %}<li class="{{ key == doc.stage ? 'is-current' }}">{{ label }}{{ key == doc.stage ? ' — etapa atual' }}</li>{% endfor %}</ol>
{% if kflow_can('approval') and doc.stage != 'complete' %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('document-'~doc.id) }}"><input type="hidden" name="action" value="advance"><label class="form-label">Conferência / referência da SC, cotação, OC ou NF no ERP<textarea class="form-control" name="note" required maxlength="4000"></textarea></label><button class="btn btn-outline-primary">Registrar conclusão desta etapa</button></form>{% endif %}
<a href="{{ path('united_approvals') }}">Abrir Aprovações</a></section>
<section class="kflow-surface mt-4"><h2>Histórico</h2><table class="table"><thead><tr><th>Data</th><th>Responsável</th><th>Ação / referência</th></tr></thead><tbody>{% for event in audit %}<tr><td>{{ event.created_at|date('d/m/Y H:i') }}</td><td>{{ event.username }}</td><td>{{ {'document.send.started': 'Envio iniciado', 'document.sent': 'Envio confirmado', 'document.unconfirmed': 'Envio aguardando conferência', 'workflow.advance': 'Etapa concluída'}[event.action]|default(event.action) }} {{ event.details.reference|default(event.details.receipt|default('')) }}</td></tr>{% else %}<tr><td colspan="3">Sem movimentações.</td></tr>{% endfor %}</tbody></table></section>
{% endblock %}
