{% extends 'base.html.twig' %}
{% block title %}United Ati · Vínculos de listas{% endblock %}
{% block page_title %}Vínculos de listas{% endblock %}
{% block main %}
<section class="kflow-page-heading"><div><h1>Vínculos de listas</h1><p>{{ erp }} · {{ form == 'products' ? 'Produtos' : (form == 'requests' ? 'Solicitações' : 'Requisições') }}. Escolha de onde virão os códigos e nomes disponíveis para seleção.</p></div><a class="btn btn-outline-primary" href="{{ form == 'products' ? path('kflow_products') : path('united_documents', {kind: form}) }}">Voltar</a></section>
{% if form != 'products' %}<p>Produto utiliza o vínculo do cadastro de Produtos. <a href="{{ path('united_lookup_settings', {form: 'products'}) }}">Configurar lista de produtos por API / WS ou outra origem do cadastro</a></p>{% endif %}
<section class="kflow-surface mb-3"><h2>Relacionamentos dos campos</h2><div class="table-responsive"><table class="table"><thead><tr><th>Campo</th><th>Origem</th><th>Código → Nome</th><th></th></tr></thead><tbody>{% for relation in relationships %}<tr><td>{{ relation.label }}</td><td>{{ {'database':'Banco de dados','api':'API','webservice':'WebService'}[relation.method]|default('Não configurado') }} · {{ relation.origin }}</td><td>{{ relation.code }} → {{ relation.name }}</td><td><a href="{{ path('united_lookup_settings', {form: relation.key == 'product' ? 'products' : form, field: relation.key, method: relation.method ?: method}) }}">Configurar</a></td></tr>{% endfor %}</tbody></table></div></section>
{% if error %}<div class="alert alert-warning">{{ error }}</div>{% endif %}
<section class="kflow-surface"><form method="get" class="kflow-form-grid"><label>Campo<select name="field" class="form-select">{% for key, definition in fields %}<option value="{{ key }}" {{ key == field ? 'selected' }}>{{ definition.label }}</option>{% endfor %}</select></label><label>Conexão<select name="method" class="form-select">{% for key, label in {'database':'Banco de dados','api':'API','webservice':'WebService'} %}<option value="{{ key }}" {{ key == method ? 'selected' }}>{{ label }}</option>{% endfor %}</select></label>{% if method == 'database' %}<label>Tabela da lista<select name="table" class="form-select"><option value="">Selecione</option>{% for table in tables %}<option {{ source.table|default('') == table ? 'selected' }}>{{ table }}</option>{% endfor %}</select></label>{% endif %}<button class="btn btn-outline-primary">Carregar origem</button></form><hr>
<form method="post" class="kflow-form-grid"><input type="hidden" name="_token" value="{{ csrf_token('lookup-'~form~'-'~field~'-'~method) }}"><input type="hidden" name="source[table]" value="{{ source.table|default('') }}"><label class="kflow-form-grid__wide"><input type="checkbox" name="enabled" value="1" {{ source.enabled|default(false) ? 'checked' }}> Usar esta origem para a lista de {{ fields[field].label }}</label>
{% if form == 'products' %}<label class="kflow-form-grid__wide">Usar os campos do formulário de Produtos<select name="source[mapping_form]" class="form-select"><option value="">Mapeamento específico desta lista</option>{% for id, label in productForms %}<option value="{{ id }}" {{ source.mapping_form|default('') == id ? 'selected' }}>{{ label }} · {{ id }}</option>{% endfor %}</select><small>Ao selecionar um formulário, código, nome e código de barras acompanham seus vínculos. Em API/WS, informe também a operação de pesquisa e o caminho da coleção abaixo.</small></label>{% endif %}
{% for key, label in {'value':'Código / valor enviado ao ERP','label':'Nome / descrição','barcode':'Código de barras (opcional)','company_column':'Empresa ERP (opcional, BD)'} %}<label>{{ label }}{% if method == 'database' %}<select class="form-select" name="source[{{ key }}]"><option value="">Selecione</option>{% for column in columns %}<option {{ source[key]|default('') == column ? 'selected' }}>{{ column }}</option>{% endfor %}</select>{% else %}<input class="form-control" name="source[{{ key }}]" value="{{ source[key]|default('') }}">{% endif %}</label>{% endfor %}
{% if method != 'database' %}{% for key, label in {'operation':'Rota GET / operação SOAP de pesquisa','items_path':'Caminho da coleção (ex.: data.items)','search_param':'Parâmetro de pesquisa (padrão q)'} %}<label>{{ label }}<input class="form-control" name="source[{{ key }}]" value="{{ source[key]|default('') }}"></label>{% endfor %}<p>A origem deve aceitar page e page_size=25 e retornar até 25 itens por página. Credenciais e endereço são os de Conectar ERP.</p>{% endif %}
<button class="btn btn-primary">Salvar origem da lista</button></form></section>
{% endblock %}
