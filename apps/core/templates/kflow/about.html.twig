{% extends 'base.html.twig' %}

{% block title %}United · Ati Solution · Sobre{% endblock %}
{% block page_title %}Sobre{% endblock %}

{% block main %}
    <section class="kflow-about-hero">
        <div><span class="kflow-eyebrow">United · Ati Solution · Integration Platform</span><h1>Informações da plataforma</h1><p>Versão instalada, diagnóstico técnico e canais oficiais da Ati Solution.</p></div>
        <div class="kflow-about-release"><div><i class="bi bi-box-seam"></i><span>Versão<strong>{{ release.version }}</strong></span></div><div><i class="bi bi-hash"></i><span>Build<strong>{{ release.build }}</strong></span></div></div>
    </section>

    <div class="kflow-about-layout">
        <section class="kflow-surface kflow-about-card kflow-about-card--diagnostic">
            <div class="kflow-about-card__heading"><span class="kflow-about-card__icon"><i class="bi bi-clipboard2-pulse"></i></span><div><span class="kflow-eyebrow">Diagnóstico</span><h2>Informações para suporte</h2><p>Gere um resumo técnico da sessão atual para compartilhar com a equipe de atendimento.</p></div></div>
            <button class="btn kflow-about-copy" type="button" data-diagnostic-copy><i class="bi bi-copy"></i>Copiar informações de diagnóstico</button>
            <p class="kflow-input-help">Inclui versão, build, empresa, ERP, sessão, navegador e tamanho da tela.</p>
            <pre class="visually-hidden" data-diagnostic-base>Diagnóstico — United · Ati Solution
Gerado em: {{ 'now'|date('d/m/Y, H:i:s') }}
App: Versão {{ release.version }} - Build {{ release.build }}
Versão: {{ release.version }}
Build: {{ release.build }}
URL: https://atisolution.com.br
--- Perfil ativo ---
Empresa: {{ activeCompany ? activeCompany.name : 'Nenhuma empresa selecionada' }}
ERP: {{ activeErp ?: 'Nenhum ERP selecionado' }}
--- Sessão ---
Usuário: {{ app.user.userIdentifier }} · Perfil: {{ isPlatformAdmin ? 'administrador da plataforma' : 'usuário da plataforma' }}
--- Histórico ---
Pedidos no histórico local: 0
--- Ati Solution ---
Site: www.atisolution.com.br
Telefone: (27) 3535-0168
E-mail: contato@atisolution.com.br
CNPJ: 55.044.004/0001-63</pre>
        </section>

        <section class="kflow-surface kflow-about-card kflow-about-card--contact">
            <div class="kflow-about-card__heading"><span class="kflow-about-card__icon"><i class="bi bi-headset"></i></span><div><span class="kflow-eyebrow">Ati Solution</span><h2>Canais de atendimento</h2><p>Fale com a nossa equipe comercial, técnica ou de implantação.</p></div></div>
            <div class="kflow-about-contact"><i class="bi bi-globe2"></i><div><small>Site</small><a href="https://atisolution.com.br" target="_blank" rel="noopener">www.atisolution.com.br</a></div></div>
            <div class="kflow-about-contact"><i class="bi bi-telephone"></i><div><small>Contato</small><strong>(27) 3535-0168</strong></div></div>
            <div class="kflow-about-contact"><i class="bi bi-envelope"></i><div><small>E-mail</small><a href="mailto:contato@atisolution.com.br">contato@atisolution.com.br</a></div></div>
            <div class="kflow-about-contact"><i class="bi bi-buildings"></i><div><small>CNPJ</small><strong>55.044.004/0001-63</strong></div></div>
        </section>
    </div>
{% endblock %}
