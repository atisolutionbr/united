{% extends 'base.html.twig' %}

{% block title %}United Ati · Visão geral{% endblock %}
{% block page_title %}Visão geral{% endblock %}

{% block main %}
    <section class="kflow-page-heading">
        <div>
            <span class="kflow-eyebrow">Integration Platform</span>
            <h1>Cadastros confiáveis, conectados e em movimento</h1>
            <p>Conecte ERPs, saneie dados, mantenha uma base mestre e conduza cada aprovação até a operação.</p>
        </div>
        <div class="kflow-page-actions">
            <button class="btn btn-outline-primary" type="button" data-layout-customize="dashboard"><i class="bi bi-sliders"></i>Personalizar</button>
            <button class="btn btn-outline-secondary" type="button" data-layout-cancel="dashboard" hidden><i class="bi bi-x-lg"></i>Cancelar</button>
            <a class="btn btn-primary" href="{{ path('kflow_erp_index') }}"><i class="bi bi-plus-lg"></i>Conectar ERP</a>
        </div>
    </section>

    <p data-dashboard-pending {{ metricsError ? 'data-metrics-error' }}>{% if pendingMetrics|filter(v => v)|length %}Indicadores ainda não consultados.{% else %}Indicadores da última consulta disponível.{% endif %}</p><button type="button" class="btn btn-outline-primary mb-3" data-dashboard-refresh>Atualizar indicadores</button>
    <section class="kflow-stat-grid kflow-layout-grid" data-layout-grid="dashboard-main" aria-label="Resumo operacional">
        {% set dashboardCards = [
            {id: 'erp', label: 'ERP ativo', value: activeErp ?: 'Nenhum selecionado', icon: 'hdd-stack', tone: 'teal', href: path('kflow_erp_index')},
            {id: 'erps', label: 'ERPs disponíveis', value: erpCount, icon: 'diagram-3', tone: 'blue', href: path('kflow_erp_index')},
            {id: 'duplicates', label: 'Qtd de Produtos que podem estar duplicados', value: metrics.duplicates, icon: 'copy', tone: 'amber', href: path('kflow_products', {focus: 'sanitization'})},
            {id: 'fiscal', label: 'Qtd produtos análise fiscal', value: metrics.fiscalPending, icon: 'shield-exclamation', tone: 'blue', href: path('kflow_products', {focus: 'fiscal'})},
            {id: 'products', label: 'Qtd Produtos na base' ~ (activeErp ? ' (' ~ activeErp ~ ')' : ''), value: metrics.products, icon: 'box-seam', tone: 'teal', href: path('kflow_products')},
            {id: 'clients-address', label: 'Qtd Clientes S/ Endereço', value: metrics.clientsMissingAddress, icon: 'geo-alt', tone: 'amber', href: path('kflow_clients', {focus: 'sanitization'})},
            {id: 'clients-stale', label: 'Qtd Clientes Desatualizados', value: metrics.clientsStale, icon: 'person-exclamation', tone: 'blue', href: path('kflow_clients', {focus: 'fiscal'})},
            {id: 'suppliers-address', label: 'Qtd Fornecedores S/ Endereço', value: metrics.suppliersMissingAddress, icon: 'truck', tone: 'teal', href: path('kflow_suppliers')},
            {id: 'suppliers-stale', label: 'Qtd Fornecedores Desatualizados', value: metrics.suppliersStale, icon: 'person-lines-fill', tone: 'amber', href: path('kflow_suppliers')}
        ] %}
        {% for card in dashboardCards %}
            <article class="kflow-stat kflow-layout-card" data-layout-card="{{ card.id }}" draggable="false">
                <button class="kflow-layout-card__hide" type="button" data-layout-hide title="Ocultar card" aria-label="Ocultar {{ card.label }}"><i class="bi bi-eye-slash"></i></button>
                <a href="{{ card.href }}" class="kflow-stat__link">
                    <span class="kflow-stat__icon kflow-tone-{{ card.tone }}"><i class="bi bi-{{ card.icon }}"></i></span>
                    <div><small>{{ card.label }}</small><strong>{{ (card.id in ['products', 'duplicates', 'fiscal'] and pendingMetrics.products) or (card.id starts with 'clients-' and pendingMetrics.customers) or (card.id starts with 'suppliers-' and pendingMetrics.suppliers) ? '—' : card.value }}</strong></div>
                </a>
            </article>
        {% endfor %}
    </section>
    <div class="kflow-layout-recovery" data-layout-recovery="dashboard-main" hidden><span>Cards ocultos neste painel.</span><button class="btn btn-sm btn-outline-primary" type="button" data-layout-reset="dashboard-main"><i class="bi bi-arrow-counterclockwise"></i>Restaurar padrão</button></div>

    <section class="kflow-workspace-grid">
        <div class="kflow-surface kflow-surface--wide">
            <div class="kflow-section-heading">
                <div><span class="kflow-eyebrow">Fluxo United Ati</span><h2>Da origem ao dado aprovado</h2></div>
            </div>
            <div class="kflow-action-list">
                <a href="{{ path('kflow_erp_database') }}"><span><i class="bi bi-hdd-network"></i></span><div><strong>1. Conectar origem</strong><small>Banco, API ou WebService com vínculo por formulário.</small></div><i class="bi bi-arrow-right"></i></a>
                <a href="{{ path('kflow_products') }}"><span><i class="bi bi-shield-check"></i></span><div><strong>2. Sanitizar cadastro</strong><small>Identifique duplicidades, complete dados fiscais e padronize produtos.</small></div><i class="bi bi-arrow-right"></i></a>
                <a href="{{ path('kflow_module', {module: 'aprovacao'}) }}"><span><i class="bi bi-diagram-3"></i></span><div><strong>3. Aprovar e integrar</strong><small>Envie alterações pela governança certa para os fluxos operacionais.</small></div><i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
        <aside class="kflow-surface kflow-status-panel">
            <span class="kflow-eyebrow">Ambiente</span>
            <h2>Pronto para configurar</h2>
            <p>{{ activeErp ? 'O ERP '~activeErp~' está selecionado para esta sessão.' : 'Selecione um ERP para habilitar os fluxos específicos.' }}</p>
            <a href="{{ path('kflow_erp_index') }}" class="btn btn-outline-primary">Ver ERPs</a>
        </aside>
    </section>
{% endblock %}
