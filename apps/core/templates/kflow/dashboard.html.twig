{% extends 'base.html.twig' %}

{% block title %}KFlow360 · Visão geral{% endblock %}
{% block page_title %}Visão geral{% endblock %}

{% block main %}
    <section class="kflow-page-heading">
        <div>
            <span class="kflow-eyebrow">Integration Platform</span>
            <h1>Cadastros confiáveis, conectados e em movimento</h1>
            <p>Conecte ERPs, saneie dados, mantenha uma base mestre e conduza cada aprovação até a operação.</p>
        </div>
        <a class="btn btn-primary" href="{{ path('kflow_erp_index') }}"><i class="bi bi-plus-lg"></i>Conectar ERP</a>
    </section>

    <section class="kflow-stat-grid" aria-label="Resumo operacional">
        <article class="kflow-stat">
            <span class="kflow-stat__icon kflow-tone-teal"><i class="bi bi-hdd-stack"></i></span>
            <div><small>ERP ativo</small><strong>{{ activeErp ?: 'Nenhum selecionado' }}</strong></div>
        </article>
        <article class="kflow-stat">
            <span class="kflow-stat__icon kflow-tone-blue"><i class="bi bi-diagram-3"></i></span>
            <div><small>ERPs disponíveis</small><strong>{{ erpCount }}</strong></div>
        </article>
        <article class="kflow-stat">
            <span class="kflow-stat__icon kflow-tone-amber"><i class="bi bi-clipboard2-check"></i></span>
            <div><small>Camadas de integração</small><strong>5</strong></div>
        </article>
    </section>

    <section class="kflow-workspace-grid">
        <div class="kflow-surface kflow-surface--wide">
            <div class="kflow-section-heading">
                <div><span class="kflow-eyebrow">Fluxo KFlow360</span><h2>Da origem ao dado aprovado</h2></div>
            </div>
            <div class="kflow-action-list">
                <a href="{{ path('kflow_erp_database') }}"><span><i class="bi bi-hdd-network"></i></span><div><strong>1. Conectar origem</strong><small>Banco, API ou WebService com vínculo por formulário.</small></div><i class="bi bi-arrow-right"></i></a>
                <a href="{{ path('kflow_products') }}"><span><i class="bi bi-shield-check"></i></span><div><strong>2. Sanitizar cadastro</strong><small>Identifique duplicidades, complete dados fiscais e padronize produtos.</small></div><i class="bi bi-arrow-right"></i></a>
                <a href="{{ path('kflow_module', {module: 'aprovacao'}) }}"><span><i class="bi bi-diagram-3"></i></span><div><strong>3. Aprovar e integrar</strong><small>Envie alterações pela governança certa para os fluxos operacionais.</small></div><i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
        <aside class="kflow-surface kflow-status-panel">
            <span class="kflow-eyebrow">Ambiente</span>
            <h2>Pronto para configurar</h2>
            <p>{{ activeErp ? 'O ERP '~activeErp~' está selecionado para esta sessão.' : 'Selecione um ERP para habilitar os fluxos específicos.' }}</p>
            <a href="{{ path('kflow_erp_index') }}" class="btn btn-outline-primary">Ver ERPs</a>
        </aside>
    </section>
{% endblock %}
