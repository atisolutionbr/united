{% extends 'base.html.twig' %}{% block title %}Enviar ajustes · {{ title }}{% endblock %}{% block main %}
<section class="kflow-surface"><h1>Enviar ajustes · {{ title }}</h1><p>Selecione os campos que serão gravados. A próxima etapa mostra os destinos e valores antes do envio.</p>
<form method="get" class="kflow-form-grid"><label>Método<select class="form-select" name="method">{% for key,label in {'database':'Banco de dados','api':'API','webservice':'WebService'} %}<option value="{{ key }}" {{ method==key?'selected' }}>{{ label }}</option>{% endfor %}</select></label><label>Operação<select class="form-select" name="action">{% for key,label in {'insert':'Incluir','update':'Atualizar','delete':'Excluir'} %}<option value="{{ key }}" {{ action==key?'selected' }}>{{ label }}</option>{% endfor %}</select></label><button class="btn btn-outline-primary">Selecionar</button></form>
{% if kflow_can('connections') %}<a href="{{ path('united_write_configure',{form:form,method:method,action:action}) }}">Configurar campos e destinos</a>{% endif %}
{% if error %}<div class="alert alert-warning">{{ error }}</div>{% endif %}
{% if config %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('write-'~form) }}"><h2>{{ {'insert':'Incluir registro','update':'Atualizar registro','delete':'Excluir registro'}[action] }}</h2><p>Destino: {{ config.table|default(config.write_operation|default(method)) }}</p>
<div class="kflow-form-grid">{% for key in keyFields %}<label>Chave: {{ key }}<input class="form-control" name="keys[{{ key }}]" value="{{ keys[key]|default('') }}" required></label>{% endfor %}</div>
{% if action!='delete' %}<h2>Campos a enviar</h2><div class="kflow-form-grid">{% for key,destination in config.mapping %}<label><input type="checkbox" name="selected[]" value="{{ key }}" {{ key in selected?'checked' }}> {{ fields[key].label|default(key) }} → {{ destination }}<input class="form-control" name="data[{{ key }}]" value="{{ input[key]|default('') }}"></label>{% endfor %}</div>{% endif %}<button class="btn btn-primary mt-3">Revisar antes de enviar</button></form>{% else %}<p>Esta operação ainda não possui vínculo de gravação. Configure os destinos para continuar.</p>{% endif %}
<h2 class="mt-4">Últimas operações</h2>{% for item in history %}<p><a href="{{ path('united_write_review',{form:form,id:item.id}) }}">#{{ item.id }}</a> · {{ item.status }} · {{ item.created_at }}</p>{% else %}<p>Nenhuma operação preparada.</p>{% endfor %}</section>{% endblock %}
