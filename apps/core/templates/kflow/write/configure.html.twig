{% extends 'base.html.twig' %}{% block title %}Vínculo de gravação · {{ title }}{% endblock %}{% block main %}
<section class="kflow-surface"><h1>Vínculo de gravação · {{ title }}</h1><p>Defina quais campos podem ser enviados e a chave completa usada em alterações e exclusões. Salvar o vínculo não altera registros do ERP.</p>
<form method="get" class="kflow-form-grid"><label>Método<select class="form-select" name="method">{% for key,label in {'database':'Banco de dados','api':'API','webservice':'WebService'} %}<option value="{{ key }}" {{ method==key?'selected' }}>{{ label }}</option>{% endfor %}</select></label><label>Operação<select class="form-select" name="action">{% for key,label in {'insert':'Incluir','update':'Atualizar','delete':'Excluir'} %}<option value="{{ key }}" {{ action==key?'selected' }}>{{ label }}</option>{% endfor %}</select></label><button class="btn btn-outline-primary">Abrir vínculo</button></form>
{% if error %}<div class="alert alert-warning">{{ error }}</div>{% endif %}
<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('write-config-'~form~'-'~method~'-'~action) }}"><div class="kflow-form-grid">
{% if method=='database' %}<label>Tabela de destino<input class="form-control" name="config[table]" value="{{ config.table|default('') }}" required placeholder="dbo.Tabela"></label>{% else %}
<label>Porta de envio (opcional)<input class="form-control" type="number" min="1" max="65535" name="config[port]" value="{{ config.port|default('') }}" placeholder="Usar porta da conexão"></label>
{% for key,label in {'write_operation':'Rota API / operação SOAP','success_path':'Caminho da confirmação','success_value':'Valor que confirma sucesso'} %}<label>{{ label }}<input class="form-control" name="config[{{ key }}]" value="{{ config[key]|default('') }}" required></label>{% endfor %}
{% if method=='webservice' %}{% for key,label in {'soap_user_path':'Caminho do usuário no corpo SOAP (opcional)','soap_password_path':'Caminho da senha no corpo SOAP (opcional)'} %}<label>{{ label }}<input class="form-control" name="config[{{ key }}]" value="{{ config[key]|default('') }}"></label>{% endfor %}{% endif %}{% if method=='api' %}<label>Método HTTP<select class="form-select" name="config[http_method]">{% for verb in ['POST','PUT','PATCH','DELETE'] %}<option {{ config.http_method|default('POST')==verb?'selected' }}>{{ verb }}</option>{% endfor %}</select></label>{% endif %}{% endif %}
{% if action!='insert' %}<label>Campos da chave completa (destinos separados por vírgula)<input class="form-control" name="config[key_columns]" value="{{ config.key_columns|default('') }}" required><small>Inclua empresa, filial e demais partes da chave quando necessário.</small></label>{% endif %}
</div>{% if action!='delete' %}<h2>Campos que poderão ser preenchidos</h2><div class="kflow-form-grid">{% for key,field in fields %}<label>{{ field.label }}<input class="form-control" name="config[mapping][{{ key }}]" value="{{ config.mapping[key]|default('') }}" placeholder="Coluna ou propriedade de destino"></label>{% endfor %}</div>{% endif %}<button class="btn btn-primary mt-3">Salvar vínculo</button></form><a href="{{ path('united_write',{form:form,method:method,action:action}) }}">Preparar operação</a></section>{% endblock %}
