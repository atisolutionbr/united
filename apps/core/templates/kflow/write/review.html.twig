{% extends 'base.html.twig' %}{% block title %}Revisar envio #{{ row.id }}{% endblock %}{% block main %}<section class="kflow-surface"><h1>Revisar envio #{{ row.id }}</h1><p>{{ erp }} · {{ row.config.method }} · {{ {'insert':'Inclusão','update':'Atualização','delete':'Exclusão'}[row.config.action] }} · {{ row.config.table|default(row.config.write_operation|default('')) }}</p><h2>Registro de destino</h2>{% for key,value in row.record_keys %}<p><strong>{{ key }}:</strong> {{ value }}</p>{% else %}<p>Novo registro.</p>{% endfor %}
<table class="table"><thead><tr><th>Campo</th><th>Destino</th><th>Valor a enviar</th></tr></thead><tbody>{% for key,value in row.payload %}<tr><td>{{ fields[key].label|default(key) }}</td><td>{{ row.config.mapping[key] }}</td><td>{{ value }}</td></tr>{% else %}<tr><td colspan="3">Exclusão do registro identificado pela chave acima.</td></tr>{% endfor %}</tbody></table>
{% if row.status=='review' %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('write-review-'~row.id) }}"><button class="btn {{ row.config.action=='delete'?'btn-danger':'btn-primary' }}">Confirmar {{ row.config.action=='delete'?'exclusão':'envio' }} ao ERP</button></form>{% else %}<div class="alert {{ row.status=='confirmed'?'alert-success':'alert-warning' }}">{{ row.receipt ?: 'Operação iniciada, aguardando confirmação. Confira no ERP antes de reenviar.' }}</div>{% endif %}<a href="{{ path('united_write',{form:form}) }}">Voltar aos ajustes</a></section>{% endblock %}
