{% extends 'base.html.twig' %}
{% block title %}KFlow360 · Usuários{% endblock %}{% block page_title %}Usuários{% endblock %}
{% block main %}
<section class="kflow-page-heading kflow-page-heading--compact"><div><span class="kflow-eyebrow">Configurações KFlow360</span><h1>Usuários da plataforma</h1><p>Somente o KAdmin cadastra usuários, empresas e permissões.</p></div></section>
<div class="kflow-company-layout"><section class="kflow-surface"><h2>Novo usuário</h2><form action="{{ path('kflow_users_save') }}" method="post" class="kflow-form-grid"><input type="hidden" name="_token" value="{{ csrf_token('save-platform-user') }}"><div><label class="form-label">Usuário</label><input class="form-control" name="username" required></div><div><label class="form-label">Nome</label><input class="form-control" name="full_name" required></div><div><label class="form-label">E-mail</label><input class="form-control" name="email" type="email" required></div><div><label class="form-label">Senha inicial</label><input class="form-control" name="password" type="password" minlength="8" required></div><div class="kflow-form-grid__wide"><span class="form-label">Empresas permitidas</span><div class="kflow-permission-options">{% for company in companies %}<label><input type="checkbox" name="companies[]" value="{{ company.id }}"><span>{{ company.name }}</span></label>{% endfor %}</div></div><div class="kflow-form-grid__wide"><span class="form-label">Menus permitidos</span><div class="kflow-permission-options">{% for key, label in menuOptions %}<label><input type="checkbox" name="permissions[]" value="{{ key }}" {{ key in ['dashboard', 'products', 'clients', 'connections'] ? 'checked' }}><span>{{ label }}</span></label>{% endfor %}</div></div><div class="kflow-company-layout__action"><button class="btn btn-primary" type="submit"><i class="bi bi-person-add"></i>Salvar usuário</button></div></form></section><section class="kflow-surface"><h2>Contas cadastradas</h2><div class="kflow-company-list">{% for user in users %}<div><span><strong>{{ user.userIdentifier }}</strong><small>{{ user.fullName }} · {{ user.email }}</small></span><span class="badge text-bg-light">{{ user.userIdentifier|lower == 'kadmin' ? 'KAdmin' : 'Plataforma' }}</span></div>{% endfor %}</div></section></div>
{% endblock %}
