<div class="kflow-form-manager" data-form-manager>
    <div><strong>Formulários disponíveis</strong><small>Selecione um formulário para conferir ou editar o vínculo. A exclusão só vale para formulários adicionais.</small></div>
    <div class="kflow-form-manager__items">
        {% for definition in configuredForms %}
            {% set table = bindings[definition.id].table|default('') %}
            {% set targetStep = method == 'database' ? 'table' : 'mapping' %}
            <a class="kflow-form-chip kflow-form-chip--select {{ table ? 'is-bound' }}" href="{{ path('kflow_erp_connect', {erp: erp, method: method, step: targetStep, form: definition.id}) }}" title="Abrir vínculo de {{ definition.label }}">
                <span>{{ definition.label }}</span>
                <small>{{ table ?: 'Sem vínculo' }}</small>
            </a>
            {% if definition.id starts with 'form-' %}
                <button class="kflow-form-chip kflow-form-chip--delete" type="button" data-form-delete data-form-id="{{ definition.id }}" data-method="{{ method }}" data-token="{{ csrf_token('delete-integration-form-'~erp~'-'~method~'-'~definition.id) }}" data-url="{{ path('kflow_erp_forms_delete', {erp: erp, form: definition.id}) }}" aria-label="Excluir formulário {{ definition.label }}" title="Excluir formulário e vínculos">
                    <i class="bi bi-trash3"></i>
                </button>
            {% endif %}
        {% else %}
            <span class="kflow-form-manager__empty">Nenhum formulário disponível.</span>
        {% endfor %}
    </div>
</div>
