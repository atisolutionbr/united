{% extends 'base.html.twig' %}

{% block title %}United · Ati Solution · Conectar ERP{% endblock %}
{% block page_title %}Configurações de Conexão{% endblock %}

{% block main %}
    <section class="kflow-page-heading">
        <div><span class="kflow-eyebrow">Configurações de Conexão</span><h1>Conectar ERP</h1><p>Escolha o ERP que orientará os fluxos e consultas do United.</p></div>
    </section>
    <section class="kflow-erp-grid">
        {% set erpLogos = {
            'Senior': 'images/erp/senior.png',
            'Sankhya': 'images/erp/sankhya.png',
            'RM': 'images/erp/rm.png',
            'Protheus': 'images/erp/protheus.png',
            'Cigam': 'images/erp/cigam.webp',
            'Winthor': 'images/erp/winthor.png',
            'Mega': 'images/erp/mega.png',
            'WK': 'images/erp/wk.png',
            'Uniplus': 'images/erp/uniplus.png',
            'PowerLogic': 'images/erp/powerlogic.png'
        } %}
        {% for erp in erps %}
            {% set connection = connections[erp]|default(null) %}
            {% set enabled = connection and connection.isActive %}
            <article class="kflow-erp-card {{ erp == activeErp ? 'is-selected' }} {{ enabled ? 'is-enabled' : 'is-disabled' }}" data-erp="{{ erp|lower }}">
                <div class="kflow-erp-card__top">
                    <span class="kflow-erp-card__mark {{ erp in erpLogos|keys ? 'has-logo' }}">
                        {% if erp in erpLogos|keys %}<img src="{{ asset(erpLogos[erp]) }}" alt="{{ erp }}">{% else %}<span>{{ erp|slice(0, 2)|upper }}</span>{% endif %}
                    </span>
                    <form class="kflow-erp-card__switch" method="post" action="{{ path('kflow_erp_active', {erp: erp}) }}"><input type="hidden" name="_token" value="{{ csrf_token('erp-active-'~erp) }}"><input type="hidden" name="active" value="{{ enabled ? '0' : '1' }}"><button type="submit" role="switch" aria-checked="{{ enabled ? 'true' : 'false' }}" aria-label="{{ enabled ? 'Desativar' : 'Ativar' }} {{ erp }}" title="{{ enabled ? 'ERP ativo. Clique para desativar' : 'ERP inativo. Clique para ativar' }}"><span></span></button><small>{{ enabled ? 'Ativo' : 'Inativo' }}</small></form>
                </div>
                <h2>{{ erp }}</h2>
                <p>Conecte seu ERP e conheça o que o United poderá fazer por você! Automatize seus processos, tenha segurança e venha ser United... Onde tudo flui com rapidez em todos os angulos.</p>
                <form method="post" action="{{ path('kflow_erp_select', {erp: erp}) }}"><input type="hidden" name="_token" value="{{ csrf_token('select-erp-'~erp) }}"><button class="btn {{ erp == activeErp ? 'btn-outline-primary' : 'btn-primary' }} w-100" type="submit"><i class="bi bi-plug"></i>{{ erp == activeErp ? 'Configurar conexão' : 'Conectar '~erp }}</button></form>
            </article>
        {% endfor %}
    </section>
{% endblock %}
