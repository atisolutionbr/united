<!DOCTYPE html>
<html lang="pt-BR">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}KFlow360{% endblock %}</title>
        <link rel="icon" type="image/png" href="{{ asset('favicon.png') }}">
        <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
        {% block stylesheets %}{% endblock %}
    </head>
    <body id="{% block body_id %}{% endblock %}" class="kflow-body {{ app.user ? 'kflow-shell' : 'kflow-login-shell' }}{% block body_class %}{% endblock %}">
        {% if app.user %}
            {% include 'components/_sidebar.html.twig' %}
        {% endif %}

        <div class="kflow-app">
            {% if app.user %}
                <header class="kflow-topbar">
                    <button class="kflow-icon-button" type="button" data-sidebar-toggle aria-label="Mostrar ou ocultar menu" title="Mostrar ou ocultar menu">
                        <i class="bi bi-layout-sidebar-inset"></i>
                    </button>
                    <div class="kflow-topbar__identity">
                        <span class="kflow-topbar__eyebrow">KFlow360 · Integration Platform</span>
                        <strong>{% block page_title %}Central de operações{% endblock %}</strong>
                    </div>
                    <div class="kflow-topbar__account">
                        <span class="d-none d-sm-inline">{{ app.user.fullName is not empty ? app.user.fullName : app.user.userIdentifier }}</span>
                    <form action="{{ path('_logout_main') }}" method="post">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                            <button class="kflow-icon-button" type="submit" aria-label="Sair" title="Sair"><i class="bi bi-box-arrow-right"></i></button>
                        </form>
                    </div>
                </header>
            {% endif %}

            {% block body %}
                <main class="kflow-main">
                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ label }} kflow-alert" role="alert">{{ message }}</div>
                        {% endfor %}
                    {% endfor %}
                    {% block main %}{% endblock %}
                </main>
                {% block sidebar %}{% endblock %}
            {% endblock %}
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% block javascripts %}{% endblock %}
    </body>
</html>
