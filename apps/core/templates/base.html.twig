<!DOCTYPE html>
<html lang="pt-BR">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}KFlow360{% endblock %}</title>
        <link rel="icon" type="image/png" href="{{ asset('favicon.png') }}">
        <link rel="manifest" href="{{ asset('manifest.webmanifest') }}">
        <meta name="theme-color" content="#004a7c">
        <meta name="mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-capable" content="yes">
        <link rel="apple-touch-icon" href="/images/kflow360-logo.png">
        <link href="/vendor/bootstrap.min.css" rel="stylesheet">
        <link href="/vendor/bootstrap-icons.min.css" rel="stylesheet">
        <link href="{{ asset('kflow.css') }}" rel="stylesheet">
        {% block stylesheets %}{% endblock %}
    </head>
    <body id="{% block body_id %}{% endblock %}" class="kflow-body {{ app.user ? 'kflow-shell' : 'kflow-login-shell' }}{% block body_class %}{% endblock %}">
        {% if app.user %}
            {% include 'components/_sidebar.html.twig' %}
        {% endif %}

        <div class="kflow-app">
            {% if app.user %}
                <header class="kflow-topbar">
                    <button class="kflow-icon-button" type="button" data-sidebar-toggle aria-label="Mostrar ou ocultar menu" title="Mostrar ou ocultar menu">
                        <i class="bi bi-layout-sidebar-inset"></i>
                    </button>
                    <div class="kflow-topbar__identity">
                        <span class="kflow-topbar__eyebrow">KFlow360 · Integration Platform</span>
                        <strong>{% block page_title %}Central de operações{% endblock %}</strong>
                    </div>
                    <div class="kflow-topbar__account">
                        {% set activeCompany = kflow_active_company() %}
                        {% set companies = kflow_companies() %}
                        {% if activeCompany and companies|length > 0 %}
                        <form action="{{ path('kflow_company_select', {company: activeCompany.id}) }}" method="post" class="kflow-company-select">
                            <input type="hidden" name="_token" value="{{ csrf_token('select-company-'~activeCompany.id) }}">
                            <input type="hidden" name="redirect" value="{{ app.request.uri }}">
                            <label for="company-switch">Empresa</label>
                            <select id="company-switch" onchange="this.form.action=this.options[this.selectedIndex].dataset.action; this.form.submit()">
                                {% for company in companies %}<option value="{{ company.id }}" data-action="{{ path('kflow_company_select', {company: company.id}) }}" {{ company.id == activeCompany.id ? 'selected' }}>{{ company.name }}</option>{% endfor %}
                            </select>
                        </form>
                        {% endif %}
                        {% set activeErp = kflow_active_erp() %}{% set availableErps = kflow_available_erps() %}
                        {% if availableErps|length > 1 %}<form action="{{ path('kflow_erp_select', {erp: activeErp ?: availableErps|first}) }}" method="post" class="kflow-company-select kflow-erp-select"><input type="hidden" name="_token" value="{{ csrf_token('select-erp-'~(activeErp ?: availableErps|first)) }}"><select aria-label="Selecionar ERP" onchange="this.form.action=this.options[this.selectedIndex].dataset.action; this.form.querySelector('input').value=this.options[this.selectedIndex].dataset.token; this.form.submit()">{% for erp in availableErps %}<option value="{{ erp }}" data-action="{{ path('kflow_erp_select', {erp: erp}) }}" data-token="{{ csrf_token('select-erp-'~erp) }}" {{ erp == activeErp ? 'selected' }}>{{ erp }}</option>{% endfor %}</select></form>{% elseif activeErp %}<span class="kflow-context-pill"><i class="bi bi-database"></i>{{ activeErp }}</span>{% endif %}
                        <span class="d-none d-sm-inline">{{ app.user.fullName is not empty ? app.user.fullName : app.user.userIdentifier }}</span>
                    <form action="{{ path('_logout_main') }}" method="post">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                            <button class="kflow-icon-button" type="submit" aria-label="Sair" title="Sair"><i class="bi bi-box-arrow-right"></i></button>
                        </form>
                    </div>
                </header>
            {% endif %}

            {% block body %}
                <main class="kflow-main">
                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ label }} kflow-alert" role="alert">{{ message }}</div>
                        {% endfor %}
                    {% endfor %}
                    {% block main %}{% endblock %}
                </main>
                {% block sidebar %}{% endblock %}
            {% endblock %}
        </div>

        {% if app.user or app.request.pathInfo starts with '/login' %}<script type="module" src="{{ asset('kflow.js') }}"></script>{% else %}{% block importmap %}{{ importmap('app') }}{% endblock %}{% endif %}
        {% block javascripts %}{% endblock %}
    </body>
</html>
